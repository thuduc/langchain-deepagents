PORTKEY_API_KEY=your-portkey-api-key-goes-here
PORTKEY_PROVIDER_SLUG=your-portkey-provider-slug-goes-here
# use a model that your LLM Integration slug supports (e.g. gpt-5.5)
MODEL=model_that_your_slug_supports
# for GPT models, set to 1.0
TEMPERATURE=1.0
# location of the skills folder
SKILLS_DIR=skills
