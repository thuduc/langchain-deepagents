# Copy this file to `.env` and customize the values for your environment.

# Portkey API key used by the server to call the Portkey Gateway. Leave both this
# and the ARN below unset to run without a gateway at all; the app then answers
# from canned responses, which is enough to develop everything around the model.
PORTKEY_API_KEY=your-portkey-api-key-goes-here

# Where the key must come from instead of the variable above once it would sit in
# a deployed configuration. A runtime's environment is readable through its
# control plane by anyone with read access, and passing the key as a stack
# parameter also leaves it in shell history and CI logs; an ARN is worth nothing
# on its own, every read of the secret is a CloudTrail event, and rotating the
# key needs no deployment. The secret may hold the key as a bare string or as
# JSON with a PORTKEY_API_KEY, api_key, key or value field. Set one or the other,
# not both -- the plain variable wins where it is present.
# PORTKEY_API_KEY_SECRET_ARN=

# Portkey provider slug that serves the models listed below. Required whenever
# PORTKEY_API_KEY is set, and checked at startup: there is no default, because a
# wrong provider is only rejected once a prompt reaches the gateway.
PORTKEY_PROVIDER_SLUG=your-portkey-provider-slug-goes-here

# Comma-delimited list of models shown in the app Settings modal.
AVAILABLE_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-codex

# Initial model used for future prompts. Runtime changes are stored in SQLite.
DEFAULT_MODEL=gpt-5.5

# Maximum number of chat sessions retained per project.
MAX_SESSIONS_PER_PROJECT=5

# For GPT models, use 1.0 unless your provider requires another value.
TEMPERATURE=1.0

# Parent folder containing all project workspaces.
PROJECTS_DIR=projects

# Development only. When true and CDX does not supply a JWT, the app displays
# a local identity popup and stores the selection in a signed HTTP-only cookie.
# Keep this false in production.
DEEP_AGENTS_DEV_LOGIN_ENABLED=false

# Local directory for app.db, agent-checkpoints.db, and SQLite WAL/SHM sidecars.
# Keep this on a local filesystem when SQLite WAL mode is enabled.
DEEP_AGENTS_DB_DIR=deep-agents-sdk/runtime/databases

# Root for private run workspaces, temporary generated code, upload previews,
# and retained user-owned artifacts. The server creates work/, uploads/, and
# artifacts/ beneath this directory.
DEEP_AGENTS_GENERATED_DIR=deep-agents-sdk/runtime/generated

# Maximum execution time for a generated Python tool call.
PYTHON_EXECUTION_TIMEOUT_SECONDS=30

# Maximum number of simultaneously running tasks owned by one user.
MAX_CONCURRENT_RUNS_PER_USER=3

# How long a run may go without reporting progress before another process may
# declare it abandoned and free the slot it holds. Only a hard kill waits this
# out; an ordinary shutdown releases its own runs at once. Raise it if long model
# calls are being reaped mid-run, which looks like a task failing for no reason.
RUN_HEARTBEAT_TIMEOUT_SECONDS=900

# Lifetime of an administrator's ZIP preview token.
UPLOAD_PREVIEW_TTL_MINUTES=15

# Production CDX supplies the trusted x-fnma-jws-token header. The development
# login above is the only local authentication setting.

# Where agent-generated Python runs.
#   local      development only; runs as a child of this server, not isolated
#   agentcore  Amazon Bedrock AgentCore Code Interpreter, one microVM per run
DEEP_AGENTS_SANDBOX=local

# Directory holding local sandbox workspaces. Defaults to a temp directory.
# DEEP_AGENTS_LOCAL_SANDBOX_DIR=
# Interpreter that runs generated code in the local sandbox. Defaults to the one
# running this server, which is normally what you want; point it at another to
# give generated code a different set of installed packages.
# DEEP_AGENTS_LOCAL_SANDBOX_PYTHON=

# Where retained run artifacts live.
#   local  files on this host; fine for development and single-host deploys
#   s3     objects in the sandbox bucket; required for ECS Fargate, whose task
#          filesystems are neither shared between tasks nor durable
DEEP_AGENTS_ARTIFACT_STORE=local
# Defaults to AGENTCORE_BUCKET when unset.
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_PREFIX=artifacts

# Where LangGraph keeps conversation memory.
#   sqlite    a file under DEEP_AGENTS_DB_DIR; correct while the agent runs in
#             this process
#   dynamodb  a table any process can reach; required once the agent runs
#             elsewhere, such as inside an AgentCore Runtime microVM
DEEP_AGENTS_CHECKPOINTER=sqlite
# Required when DEEP_AGENTS_CHECKPOINTER=dynamodb.
# CHECKPOINT_DDB_TABLE=
# Region and offload bucket fall back to AGENTCORE_REGION and AGENTCORE_BUCKET.
# CHECKPOINT_DDB_REGION=
# CHECKPOINT_S3_BUCKET=
# CHECKPOINT_S3_PREFIX=checkpoints

# Where the agent itself runs.
#   local     in the web application's own process; the development default
#   http      another process over plain HTTP; the same contract as runtime
#             without AWS in the way, which is how the boundary is tested
#   runtime   an AgentCore Runtime microVM
# Anything other than 'local' moves the graph off this host, which puts two
# things out of its reach. Both must then be set to 'dynamodb':
#   DEEP_AGENTS_CHECKPOINTER  or the agent cannot read the checkpoint file, and
#                             every turn starts with no memory of the last one
#   DEEP_AGENTS_CANCELLATION  or the web tier records a stop that the agent
#                             never sees, against compute billing by the second
# Neither failure reports anything, so the server refuses to start on the wrong
# combination rather than letting it be discovered in production.
DEEP_AGENTS_AGENT_TRANSPORT=local
# DEEP_AGENTS_AGENT_URL=http://127.0.0.1:8080
# AGENTCORE_RUNTIME_ARN=
# Bucket used to hand generated files back. Defaults to AGENTCORE_BUCKET.
# AGENT_TRANSFER_BUCKET=

# How a request to stop a run reaches whoever is running it.
#   local     an in-process registry; correct while the agent runs in this
#             process, where a dropped connection is already noticed directly
#   dynamodb  a record the other side polls; required once the agent runs
#             elsewhere, since the disconnect is only visible to the web tier
DEEP_AGENTS_CANCELLATION=local
# Uses CHECKPOINT_DDB_TABLE. How often the running side re-reads it, in seconds.
# DEEP_AGENTS_CANCELLATION_POLL_SECONDS=2

# Checkpoints are kept indefinitely unless a retention period is set here. One
# expiring under a conversation the user can still see gives the agent amnesia
# with no visible cause, so set it only where policy requires it. Setting it also
# makes the saver manage an S3 lifecycle rule on the offload bucket, which
# CloudFormation owns for the sandbox bucket; use a separate CHECKPOINT_S3_BUCKET
# if you need retention.
# CHECKPOINT_DDB_TTL_DAYS=

# Required when DEEP_AGENTS_SANDBOX=agentcore. ./infra/deploy.sh prints these.
# AGENTCORE_REGION=us-east-1
# AGENTCORE_BUCKET=
# AGENTCORE_INTERPRETER_ID=
# AGENTCORE_DATA_ACCESS_ROLE_ARN=
# Upper bound on a session's life; sessions are stopped explicitly at run end,
# so this only matters if the server dies mid-run.
# AGENTCORE_SESSION_TIMEOUT_SECONDS=3600
