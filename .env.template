# Copy this file to `.env` and customize the values for your environment.

# Portkey API key used by the server to call the Portkey Gateway.
PORTKEY_API_KEY=your-portkey-api-key-goes-here

# Portkey provider slug that supports the models listed below.
PORTKEY_PROVIDER_SLUG=your-portkey-provider-slug-goes-here

# Comma-delimited list of models shown in the app Settings modal.
AVAILABLE_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-codex

# Initial model used for future prompts. Runtime changes are stored in SQLite.
DEFAULT_MODEL=gpt-5.5

# Maximum number of chat sessions retained per user and project. The limit is
# applied when a chat is created and when it is lowered in Settings; listing
# chats never deletes them.
MAX_SESSIONS_PER_PROJECT=5

# For GPT models, use 1.0 unless your provider requires another value.
TEMPERATURE=1.0

# Parent folder containing all project workspaces.
PROJECTS_DIR=projects

# Development only. When true and CDX does not supply a JWT, the app displays
# a local identity popup and stores the selection in a signed HTTP-only cookie.
# Keep this false in production.
DEEP_AGENTS_DEV_LOGIN_ENABLED=false

# Local directory for app.db, agent-checkpoints.db, and SQLite WAL/SHM sidecars.
# Keep this on a local filesystem when SQLite WAL mode is enabled.
DEEP_AGENTS_DB_DIR=deep-agents-sdk/runtime/databases

# Root for private run workspaces, temporary generated code, upload previews,
# and retained user-owned artifacts. The server creates work/, uploads/, and
# artifacts/ beneath this directory.
DEEP_AGENTS_GENERATED_DIR=deep-agents-sdk/runtime/generated

# Maximum execution time for a generated Python tool call.
PYTHON_EXECUTION_TIMEOUT_SECONDS=30

# Maximum number of simultaneously running tasks owned by one user.
MAX_CONCURRENT_RUNS_PER_USER=3

# Lifetime of an administrator's ZIP preview token.
UPLOAD_PREVIEW_TTL_MINUTES=15

# Production CDX supplies the trusted x-fnma-jws-token header. The development
# login above is the only local authentication setting.
